# Grafana admin account (seeded on first boot; change via the UI afterwards,
# same caveat as deploy/mlflow's MLFLOW_ADMIN_PASSWORD -- not re-read on
# later restarts). No placeholder value here on purpose: docker-compose.yml
# fails fast (${GF_SECURITY_ADMIN_PASSWORD:?...}) if this is left empty,
# rather than silently starting Grafana with a blank admin password on a
# resource that gets a public subdomain.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# Public subdomain assigned to the Grafana resource in Coolify, e.g.
# grafana.ghostface.tech. Only Grafana needs a public domain -- Prometheus
# stays internal-only (expose: ["9090"] in docker-compose.yml), reached
# only by Grafana's own datasource inside this same Compose resource.
GRAFANA_DOMAIN=methane-detection-grafana.ghostface.tech

# Pushover credentials for the Grafana alert contact point (TASK-6.1 step
# 4). Reuses the same Pushover account already wired into Coolify's own
# deploy notifications -- create a separate Pushover "Application" for
# Grafana (Pushover -> Your Applications -> Create New Application) to get
# a distinct API token from Coolify's own, so the two integrations can be
# revoked independently; the user key is the same one either way (identifies
# your Pushover account, not the application).
PUSHOVER_API_TOKEN=<your-pushover-application-api-token>
PUSHOVER_USER_KEY=<your-pushover-user-key>