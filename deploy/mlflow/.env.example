# Postgres backend store credentials.
# IMPORTANT: generate POSTGRES_PASSWORD as hex only (e.g. `openssl rand -hex 24`).
# Docker Compose interpolates $VAR/${VAR} across the *entire* compose file, including
# inside values pulled from this .env file — a password containing a literal `$`
# (as many password generators, including Coolify's, produce by default) gets
# partially "eaten" as a bogus variable reference before the container ever starts,
# silently truncating the password. Sticking to [0-9a-f] sidesteps this entirely,
# and also avoids `@`, `:`, `/` breaking the postgresql:// connection URI itself.
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow

# Backblaze B2 (S3-compatible) artifact store.
# Create an "Application Key" scoped to a single bucket in the B2 console,
# not the master key — MLflow only needs read/write access to this bucket.
# Endpoint format: https://s3.<region>.backblazeb2.com (region shown on the bucket's detail page)
MLFLOW_S3_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
B2_APPLICATION_KEY_ID=<your-b2-key-id>
B2_APPLICATION_KEY=<your-b2-application-key>
B2_BUCKET_NAME=<your-b2-bucket-name>

# MLflow's built-in basic-auth app (mlflow server --app-name basic-auth).
# admin_username/admin_password seed the one admin account on first boot only —
# change the password from the UI (or the auth REST API) after first deploy,
# this env var is not re-read afterwards. Same hex-only rule as POSTGRES_PASSWORD
# above applies to MLFLOW_ADMIN_PASSWORD. Generate both with:
#   openssl rand -hex 24   # MLFLOW_ADMIN_PASSWORD
#   openssl rand -hex 32   # MLFLOW_FLASK_SERVER_SECRET_KEY
MLFLOW_ADMIN_USERNAME=admin
MLFLOW_ADMIN_PASSWORD=change-me
MLFLOW_FLASK_SERVER_SECRET_KEY=<openssl-rand--hex-32-output>

# Host header MLflow 3.5+ requires in incoming requests (DNS-rebinding protection —
# without this, every request behind the Coolify/Traefik proxy is rejected with
# "Invalid Host header - possible DNS rebinding attack detected"). Must exactly match
# the domain set in Coolify's Domains field for the mlflow service, no scheme/port.
MLFLOW_DOMAIN=mlflow.yourdomain.com
