# Image tag pushed by TASK-4.3's cd.yml to ghcr.io/douglas-martins/methane-detection.
# Bootstrapping this Coolify resource for the first time (before cd.yml exists)?
# Point this at the one-off manual tag instead, e.g. IMAGE_TAG=bootstrap.
IMAGE_TAG=latest

# MLflow tracking-server auth -- same account used by training (Environment A)
# and the serving API's local `bentoml serve` validation. Live server:
# https://mlflow.ghostface.tech (see deploy/mlflow/).
MLFLOW_TRACKING_URI=https://mlflow.ghostface.tech
MLFLOW_TRACKING_USERNAME=admin
MLFLOW_TRACKING_PASSWORD=change-me

# Backblaze B2 (S3-compatible) artifact-store creds -- required because
# mlflow.pytorch.load_model() downloads the actual model weights from B2 at
# container startup, not just registry metadata over the MLflow HTTP API.
# Use the SAME "Application Key" scoped to the methane-detection bucket that
# deploy/mlflow/.env.example's B2_APPLICATION_KEY_ID/B2_APPLICATION_KEY use
# (read access to the mlflow-artifacts/ prefix is sufficient; this service
# never writes artifacts).
MLFLOW_S3_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
B2_APPLICATION_KEY_ID=<your-b2-key-id>
B2_APPLICATION_KEY=<your-b2-application-key>

# Which registered model/stage to load at startup. Defaults already baked
# into bentofile.yaml's docker.env (starcop-baseline-mag1c-rgb / Staging) --
# only set these here to override without rebuilding the image, e.g. to
# promote a new stage after TASK-2.3's promotion gate runs.
MODEL_NAME=starcop-baseline-mag1c-rgb
MODEL_STAGE=Staging
