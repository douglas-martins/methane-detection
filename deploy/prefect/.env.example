# Postgres backend store credentials (flow-run history, deployments,
# work-pool state). A dedicated instance -- Coolify resources don't share
# a database with each other, so this is NOT the same Postgres as
# deploy/mlflow/'s.
# IMPORTANT: generate POSTGRES_PASSWORD as hex only (e.g. `openssl rand -hex 24`).
# Same reasoning as deploy/mlflow/.env.example: Compose interpolates $VAR
# across the whole file, so a password containing a literal `$` gets
# partially eaten as a bogus variable reference before the container ever
# starts. Hex also sidesteps `@`/`:`/`/` breaking the
# postgresql+asyncpg:// connection URI itself.
POSTGRES_USER=prefect
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prefect

# Public subdomain assigned to this resource in Coolify, e.g.
# methane-detection-prefect.ghostface.tech. Used to build
# PREFECT_UI_API_URL/PREFECT_SERVER_CORS_ALLOWED_ORIGINS in
# docker-compose.yml so the browser-side UI calls back over the real
# public URL instead of its http://127.0.0.1:4200/api default -- same
# class of bug TASK-2.1 hit with MLflow's MLFLOW_SERVER_ALLOWED_HOSTS
# before that was set. Hostname only, same rule as deploy/mlflow/'s
# MLFLOW_DOMAIN -- no scheme, no port (Coolify/Traefik terminates TLS on
# 443 and proxies internally to the container's 4200; a literal ":4200"
# here would leak into PREFECT_UI_API_URL/CORS as a wrong, unreachable
# origin).
PREFECT_DOMAIN=methane-detection-prefect.ghostface.tech

# Native Prefect auth (Prefect 3.7.7's server, confirmed by reading
# prefect/server/api/server.py directly -- NOT documented as prominently
# as MLflow's --app-name basic-auth flag, easy to miss). A single
# "username:password"-shaped string: the server compares it verbatim
# (hmac.compare_digest) against the decoded HTTP Basic Auth header sent
# with every API request except /api/health and /api/ready. Set this to
# ANY "someuser:somepassword" string you choose -- there's no separate
# admin-account bootstrap step like MLflow's, this string *is* the
# credential. The Prefect UI reads this same setting (via the
# /ui-settings endpoint) and will prompt the browser for Basic Auth
# automatically once it's set. Generate the password half with
# `openssl rand -hex 24`; keep it hex-only for the same $-interpolation
# reason as POSTGRES_PASSWORD above.
#
# Every client that needs to reach this server -- the Mac/desktop worker
# processes (see ../../scripts/prefect_worker_mac.sh), any local
# `prefect` CLI session, TASK-7.2's flow code -- must set this exact same
# value as PREFECT_API_AUTH_STRING (note: API_, not SERVER_API_) in its
# own environment, alongside PREFECT_API_URL=https://<PREFECT_DOMAIN>/api.
PREFECT_API_AUTH_STRING=admin:change-me
